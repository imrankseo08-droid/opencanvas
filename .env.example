# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Your live domain, with https and no trailing slash. Used for canonical URLs,
# the sitemap, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# ─── SEARCH CONSOLE / BING (optional, paste only the code from the meta tag) ─
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── ANALYTICS (optional) ────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. When set, a cookie banner
# appears and GA loads only after the visitor accepts.
NEXT_PUBLIC_GA_ID=

# ─── FORMS: choose email (SMTP), a webhook, or both ─────────────────────────
# Where audit requests and sign-up notifications are sent
CONTACT_TO_EMAIL=hello@yourdomain.com
# SMTP from your email provider (Google Workspace, Zoho Mail, Hostinger, etc.)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Open Canvas Marketing <hello@yourdomain.com>"
# Send the visitor a short "we got your request" email (true/false)
AUTO_REPLY=true

# Webhooks (Zapier, Make, n8n, HubSpot, Zoho...). FORMS_WEBHOOK_URL is used for
# both forms unless you set the specific ones.
FORMS_WEBHOOK_URL=
AUDIT_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_URL=

# Link to the checklist PDF, emailed to people who request it (needs SMTP)
CHECKLIST_URL=

# ─── HOSTING OPTIONS ─────────────────────────────────────────────────────────
# 1 = redirect any other domain (e.g. non-www) to NEXT_PUBLIC_SITE_URL.
# Leave empty if your host/DNS already does it.
CANONICAL_REDIRECT=
# 1 = hide the whole site from search engines (use on a staging copy only)
NEXT_PUBLIC_NOINDEX=
# 1 = build a self-contained server in .next/standalone (VPS, cPanel, Docker)
STANDALONE=
